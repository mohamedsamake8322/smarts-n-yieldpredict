{
  "disease": "Bean rust",
  "scientific_name": "Uromyces appendiculatus",
  "pathogen_type": "Fungus",
  "description": "Bean rust is a fungal disease that affects bean leaves, stems and sometimes pods. It produces rust-colored pustules on leaf surfaces that reduce photosynthesis and can cause early leaf drop and yield loss.",
  "symptoms": [
    "Small white or pale yellow spots on leaves",
    "Orange, brown or rust-colored pustules on leaf underside",
    "Powdery spores released from pustules",
    "Yellowing around lesions",
    "Severely infected leaves dry and fall early",
    "Occasional pustules on stems and pods"
  ],
  "hosts": [
    "common bean",
    "kidney bean",
    "pinto bean",
    "black bean",
    "snap bean",
    "lima bean",
    "soybean",
    "cowpea",
    "other Phaseolus species"
  ],
  "favorable_conditions": [
    "Moderate temperatures (18–25°C)",
    "High humidity",
    "Frequent rainfall",
    "Leaf wetness for several hours",
    "Dense crop canopy"
  ],
  "spread": [
    "Wind-borne fungal spores",
    "Rain splash",
    "Infected plant debris",
    "Airborne spores traveling long distances"
  ],
  "management": [
    "Plant resistant bean varieties",
    "Rotate crops with non-host plants",
    "Remove infected crop residues",
    "Improve plant spacing for airflow",
    "Monitor fields early during the growing season"
  ],
