{
  "disease_name": "Yellow Sigatoka",
  "dataset_label": "Ndizi_Leaf_Yellow_Sigatoka",
  "other_names": [
    "Sehemu ya majani ya Sigatoka",
    "Sehemu ya jani la ndizi"
  ],
  "pathogen": {
    "type": "Kuvu",
    "scientific_name": "Pseudocercospora musae",
    "synonym": "Muziki wa Mycosphaerella",
    "kingdom": "Kuvu",
    "phylum": "Ascomycota"
  },
  "host_plant": {
    "primary_host": "Migomba (Musa pp.)",
    "other_hosts": [
      "Plantain"
    ]
  },
  "affected_parts": [
    "Majani"
  ],
  "symptoms": {
    "early_stage": [
      "Small pale yellow streaks (1–2 mm) on young leaves",
      "Chlorotic spots appearing near leaf margins or midrib"
    ],
    "intermediate_stage": [
      "Vichuguu vya kahawia hupanuka na kuwa lesi ndefu",
      "Madoa yaliyopakwa rangi ya manjano yanayowazunguka"
    ],
    "advanced_stage": [
      "Rangi nyeusi ya kahawia hadi madoa meusi ya necroti",
      "Maeneo makubwa ya necrotic kwenye majani",
      "Majani yaliyokauka hukauka na kuoza"
    ]
  },
  "disease_cycle": {
    "survival": "Kuvu hubaki katika jani lililoambukizwa",
    "spores": [
      "Conidaa",
      "Ascosspores"
    ],
    "spread_mechanism": [
      "Upepo",
      "Maji ya mvua",
      "Matone ya maji"
    ],
    "favorable_conditions": [
      "Unyevu mwingi",
      "Halijoto yenye joto (252525252530tokaC)",
      "Kulowesha majani kwa muda mrefu",
      "Majira ya mvua au ya mvua"
    ]
  },
  "impact": {
    "severity": "Mwenye Kiasi hadi juu",
    "effects": [
      "Utumizi wa chembe za urithi za photosynthetic",
      "Mikunjo midogo ya ndizi",
      "Ubora wa matunda ulipunguzwa",
      "Maisha mafupi zaidi ya kijani - kibichi ya matunda",
      "Tunda lililokomaa kabla ya kuiva"
    ],
    "estimated_yield_loss": "Asilimia 50 hivi ya watu walioambukizwa vibaya sana"
  },
  "distribution": [
    "Australia",
    "Asia",
    "Afrika",
    "Amerika ya Kati",
    "Amerika Kusini",
    "Karibea",
    "Oceania"
  ],
  "similar_diseases_or_confusions": [
    "Black Sigatoka (Pseudocercospora fijeensis)",
    "Jani la ndizi lina magonjwa"
  ],
  "management": {
    "cultural_control": [
      "Ondoa majani yaliyoambukizwa",
      "Kuboresha usafi wa mashamba",
      "Dumisha njia inayofaa ya kuondoa maji machafu",
      "Epuka msongamano wa mimea"
    ],
    "chemical_control": [
      "Dawa za Kukinga Kuvu",
      "Kuvu za Mfumo",
      "Bidhaa zenye tebuconazole, mancozeb, kloroothalonil"
    ],
    "biological_control": [
      "Bacillus mistili",
      "Trichoderma Allide",
      "Vyeo vya Kung'aa"
    ],
    "preventive_measures": [
      "Tumia aina mbalimbali za ndizi",
      "Kutungishwa kwa njia yenye usawaziko",
      "Kutunza Mashamba kwa Ukawaida"
    ]
  },
  "spread_risk_factors": [
    "Mazingira yenye unyevu mwingi",
    "Uondoaji mbaya wa maji machafu",
    "Kuwapo kwa majani yaliyoambukizwa",
    "Aina mbalimbali za ndizi zinazoweza kuliwa"
  ],
  "references": [
    "Sayansi ya Mimea ya Australia KING Sigatoka",
